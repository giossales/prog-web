<h2>Alterar Dados Cadastrais</h2>
<hr>

{{#if error}}
<div class="alert alert-danger" role="alert">
    {{error}}
</div>
{{/if}}

<form action="/users/update/{{user.id}}" method="POST">
    <div class="mb-3">
        <label for="fullname" class="form-label">Nome Completo</label>
        <input type="text" class="form-control" id="fullname" name="fullname" value="{{user.fullname}}" required>
    </div>
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" name="email" value="{{user.email}}" required>
    </div>
    <div class="mb-3">
        <label for="majorId" class="form-label">Curso</label>
        <select class="form-select" id="majorId" name="majorId" required>
            <option value="" disabled>Selecione um curso...</option>
            {{#each majors}}
            <option value="{{this.id}}" {{#if (eq this.id ../user.majorId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
    <a href="/" class="btn btn-secondary">Cancelar</a>
</form>