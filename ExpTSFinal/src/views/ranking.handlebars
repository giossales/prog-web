<h2><i class="bi bi-trophy-fill"></i> Ranking - Melhores Pontuações</h2>
<hr>
<p>Os 10 melhores jogadores com base em sua maior pontuação em uma única partida.</p>

<table class="table table-striped table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th scope="col">Posição</th>
            <th scope="col">Usuário</th>
            <th scope="col">Pontuação Máxima</th>
        </tr>
    </thead>
    <tbody>
        {{#each players}}
        <tr>
            <th scope="row">{{inc @index}}</th>
            <td>{{this.fullname}}</td>
            <td>{{this.maxScore}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>